#!/usr/bin/env bash
# Manage the local-router: start|stop|restart|status|logs|build|env|deploy|install|uninstall
#
# start, stop, status, install, uninstall and env are commands of the
# localrouter binary, which manages the launchd agent; this script builds the
# binary and hands them over. It keeps what needs the sources: build, restart,
# deploy and install --cutover.
#
# Sources live where this script does; the binary and its state (env,
# providers.json, models.json, history.jsonl, log) live in ROUTER_HOME,
# ~/.claude/local-router by default. This script may be reached through a
# symlink from there.
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SRC="$(cd "$(dirname "$SELF")" && pwd)"
DIR="${ROUTER_HOME:-$HOME/.claude/local-router}"

[ -f "$DIR/env" ] && { set -a; . "$DIR/env"; set +a; }
ADDR="${ROUTER_LISTEN:-127.0.0.1:8787}"
UI_ADDR="${ROUTER_UI_LISTEN:-127.0.0.1:8788}"
SLOT_MODE=0
[ -f "$DIR/deploy.json" ] && SLOT_MODE=1

build() { mkdir -p "$DIR" && (cd "$SRC" && go build -o "$DIR/localrouter" .); }

# A binary older than this script may predate its commands, and such a
# binary takes any command for serve.
stale() { [ ! -x "$DIR/localrouter" ] || [ "$DIR/localrouter" -ot "$SELF" ]; }

current() {
  if stale; then
    echo "the localrouter binary is missing or older than this script; run ./router build" >&2
    exit 1
  fi
}

build_candidate() {
  mkdir -p "$DIR"
  (cd "$SRC" && go build -o "$DIR/localrouter.candidate" .)
}

run_deploy() {
  build_candidate
  "$DIR/localrouter.candidate" deploy -home "$DIR" -binary "$DIR/localrouter.candidate" "$@"
}

install_cutover() {
  if [ "$SLOT_MODE" = 1 ]; then
    echo "cutover already installed; use 'router deploy'" >&2
    return 1
  fi
  local caddy
  caddy="$(command -v caddy)" || { echo "install caddy first" >&2; return 1; }
  build_candidate
  "$DIR/localrouter.candidate" cutover -home "$DIR" -binary "$DIR/localrouter.candidate" -caddy "$caddy" \
    -caddy-admin "${ROUTER_CADDY_ADMIN:-127.0.0.1:2019}" \
    -public-api "$ADDR" -public-ui "$UI_ADDR" \
    -blue-api "${ROUTER_BLUE_API:-127.0.0.1:8791}" -blue-ui "${ROUTER_BLUE_UI:-127.0.0.1:8793}" \
    -green-api "${ROUTER_GREEN_API:-127.0.0.1:8792}" -green-ui "${ROUTER_GREEN_UI:-127.0.0.1:8794}" "$@"
}

case "${1:-status}" in
  start)
    if stale; then build; fi
    exec "$DIR/localrouter" start -home "$DIR" ;;
  stop|status|uninstall|env)
    current
    exec "$DIR/localrouter" "${1:-status}" -home "$DIR" ;;
  restart)
    if [ "$SLOT_MODE" = 1 ]; then run_deploy -force; exit; fi
    build
    "$DIR/localrouter" stop -home "$DIR"
    sleep 0.5
    exec "$DIR/localrouter" start -home "$DIR" ;;
  build)     build; echo "built" ;;
  deploy)
    shift
    run_deploy "$@" ;;
  install)
    shift
    if [ "${1:-}" = "--cutover" ]; then shift; install_cutover "$@"
    elif [ "$#" = 0 ]; then build; exec "$DIR/localrouter" install -home "$DIR"
    else echo "usage: router install [--cutover]" >&2; exit 2; fi ;;
  logs)      tail -f "$DIR/router.log" ;;
  *) echo "usage: router {start|stop|restart|status|logs|build|env|deploy [-force]|install [--cutover]|uninstall}" >&2; exit 2 ;;
esac
