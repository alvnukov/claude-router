{
  "name": "claude-router-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
