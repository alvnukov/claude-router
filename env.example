# Backend catalog seed. Incoming models need explicit routes in the dashboard.
# Seed only: these four are read until providers.json exists (the first change
# in the UI creates it); after that providers and models live there.
ROUTER_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
ROUTER_LOCAL_API_KEY=
ROUTER_LOCAL_MODEL=local-model
# Alternative models on the same endpoint, comma-separated. When one fails
# before answering (no response within the first-byte timeout, 5xx, 404, 408,
# 429, connection error) the request is retried on the next one, best-rated
# first. ROUTER_LOCAL_FAILOVER=0 turns the switching off; the rating is still
# kept, in models.json next to the binary.
ROUTER_LOCAL_MODELS=
ROUTER_LOCAL_FAILOVER=1
ROUTER_LOCAL_FIRST_BYTE_TIMEOUT=45
# Distribute new sessions among the N best-rated models in their selected pool;
# subsequent calls keep their model until failover. 1 = always the best.
# probe idle models every N seconds in parallel so their rating stays fresh (0 = off).
ROUTER_LOCAL_BALANCE=3
ROUTER_LOCAL_PROBE_INTERVAL=30

# Budget in characters for what reaches the local model. Claude Code has no
# per-model context window, so it can build a prompt the local endpoint cannot
# take; over this size the router trims the request to fit instead of failing
# it -- oversized blocks are elided first, oldest turns dropped only if that is
# not enough, and the newest turns are given up last. 0 disables the budget.
ROUTER_LOCAL_MAX_INPUT_CHARS=100000

# Router bind address and upstream for explicitly assigned Anthropic routes.
ROUTER_LISTEN=127.0.0.1:8787
ROUTER_UPSTREAM_URL=https://api.anthropic.com

# Web UI: request inspector and settings panel, on its own loopback address.
# Shows every /v1/messages call (both routes) with the full context, so keep
# it on 127.0.0.1. Empty disables it. ROUTER_UI_HISTORY is the ring
# size, persisted to ROUTER_UI_HISTORY_FILE.
ROUTER_UI_LISTEN=127.0.0.1:8788
ROUTER_UI_HISTORY=300
# Where the history ring is persisted (default: history.jsonl next to the binary).
# Set to an empty value to keep it in memory only.
#ROUTER_UI_HISTORY_FILE=
